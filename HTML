<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>VIVA-X | AI Lab Assessment</title>

    <link rel="stylesheet"
          href="{{ url_for('static', filename='css/viva.css') }}">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>

<div class="app">

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="logo">
            <div class="logo-icon">V</div>

            <div>
                <strong>VIVA-X</strong>
                <small>AI Lab Assessment</small>
            </div>
        </div>

        <nav>

            <a class="active">
                <span>⌂</span>
                Dashboard
            </a>

            <a>
                <span>🎯</span>
                Practice
            </a>

            <a>
                <span>🧪</span>
                My Labs
            </a>

            <a>
                <span>📊</span>
                Analytics
            </a>

            <a>
                <span>🏆</span>
                Achievements
            </a>

            <a>
                <span>📚</span>
                History
            </a>

        </nav>

        <div class="sidebar-bottom">

            <a>
                ⚙ Settings
            </a>

            <a>
                ↪ Logout
            </a>

        </div>

    </aside>


    <!-- MAIN -->

    <main class="main">

        <!-- TOPBAR -->

        <header class="topbar">

            <div>

                <h2>Dashboard</h2>

                <p>
                    Your AI-powered viva preparation center
                </p>

            </div>

            <div class="profile">

                <div class="notification">
                    🔔
                </div>

                <div class="avatar">
                    H
                </div>

                <div>
                    <strong>Harish</strong>
                    <small>Student</small>
                </div>

            </div>

        </header>


        <!-- HERO -->

        <section class="hero">

            <div class="hero-content">

                <span class="badge">
                    ✦ AI VIVA ENGINE
                </span>

                <h1>
                    Ready for your<br>
                    <span>next viva?</span>
                </h1>

                <p>
                    Practice with adaptive AI questions,
                    receive instant feedback and improve
                    your laboratory performance.
                </p>

                <button class="primary-btn"
                        onclick="startViva()">

                    🎙 Start AI Viva

                </button>

            </div>

            <div class="ai-orb">

                <div class="orb-core">
                    AI
                </div>

                <div class="ring ring1"></div>
                <div class="ring ring2"></div>
                <div class="ring ring3"></div>

            </div>

        </section>


        <!-- STATS -->

        <section class="stats">

            <div class="stat-card">

                <span>Overall Score</span>

                <strong>87%</strong>

                <small class="positive">
                    ↑ 8.4% this month
                </small>

            </div>

            <div class="stat-card">

                <span>Vivas Completed</span>

                <strong>42</strong>

                <small>
                    6 this week
                </small>

            </div>

            <div class="stat-card">

                <span>Average Score</span>

                <strong>8.6/10</strong>

                <small class="positive">
                    ↑ 0.8 improvement
                </small>

            </div>

            <div class="stat-card">

                <span>Practice Streak</span>

                <strong>12 🔥</strong>

                <small>
                    Keep going!
                </small>

            </div>

        </section>


        <!-- CONTENT GRID -->

        <section class="dashboard-grid">

            <!-- PERFORMANCE -->

            <div class="panel performance">

                <div class="panel-header">

                    <div>

                        <h3>Performance</h3>

                        <p>
                            Your viva scores over time
                        </p>

                    </div>

                    <select>

                        <option>Last 30 days</option>
                        <option>Last 7 days</option>
                        <option>All time</option>

                    </select>

                </div>

                <canvas id="performanceChart"></canvas>

            </div>


            <!-- AI RECOMMENDATION -->

            <div class="panel recommendation">

                <div class="ai-title">

                    <div class="mini-ai">
                        ✦
                    </div>

                    <div>

                        <h3>AI Recommendation</h3>

                        <p>
                            Personalized for you
                        </p>

                    </div>

                </div>

                <div class="recommendation-score">

                    <span>Focus Area</span>

                    <strong>
                        Communication
                    </strong>

                    <div class="progress">

                        <div style="width:76%"></div>

                    </div>

                    <small>
                        Current proficiency: 76%
                    </small>

                </div>

                <button class="secondary-btn">

                    Start Recommended Practice →

                </button>

            </div>

        </section>


        <!-- LABS -->

        <section class="panel labs">

            <div class="panel-header">

                <div>

                    <h3>Upcoming Lab Vivas</h3>

                    <p>
                        Your scheduled assessments
                    </p>

                </div>

                <button class="link-btn">
                    View all →
                </button>

            </div>

            <div class="lab-list">

                <div class="lab">

                    <div class="lab-icon">
                        DS
                    </div>

                    <div class="lab-info">

                        <strong>
                            Data Structures
                        </strong>

                        <span>
                            Stack, Queue & Linked List
                        </span>

                    </div>

                    <div class="lab-date">
                        <strong>18</strong>
                        <span>SEP</span>
                    </div>

                    <button class="practice-btn">
                        Practice
                    </button>

                </div>


                <div class="lab">

                    <div class="lab-icon">
                        DB
                    </div>

                    <div class="lab-info">

                        <strong>
                            Database Systems
                        </strong>

                        <span>
                            SQL & Normalization
                        </span>

                    </div>

                    <div class="lab-date">
                        <strong>21</strong>
                        <span>SEP</span>
                    </div>

                    <button class="practice-btn">
                        Practice
                    </button>

                </div>


                <div class="lab">

                    <div class="lab-icon">
                        OS
                    </div>

                    <div class="lab-info">

                        <strong>
                            Operating Systems
                        </strong>

                        <span>
                            Process Scheduling
                        </span>

                    </div>

                    <div class="lab-date">
                        <strong>24</strong>
                        <span>SEP</span>
                    </div>

                    <button class="practice-btn">
                        Practice
                    </button>

                </div>

            </div>

        </section>

    </main>

</div>


<script src="{{ url_for('static', filename='js/viva.js') }}"></script>

</body>

</html>
